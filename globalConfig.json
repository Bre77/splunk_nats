  "customSearchCommand": [
    {
      "commandName": "natssubscribe",
      "fileName": "nats_subscribe_command.py",
      "commandType": "generating",
      "requiredSearchAssistant": true,
      "description": "Subscribe to NATS subject and stream messages in real-time",
      "syntax": "| natssubscribe subject=<subject> account=<account>",
      "usage": "public",
      "arguments": [
        {
          "name": "subject",
          "required": true,
          "validate": {
            "type": "RegularExpression"
          }
        },
        {
          "name": "account",
          "required": true,
          "validate": {
            "type": "RegularExpression"
          }
        }
      ]
    },
    {
      "commandName": "natskv",
      "fileName": "nats_kv_command.py",
      "commandType": "generating",
      "requiredSearchAssistant": true,
      "description": "Retrieve history from NATS JetStream Key-Value store",
      "syntax": "| natskv bucket=<bucket> key=<key> account=<account> [limit=<count>]",
      "usage": "public",
      "arguments": [
        {
          "name": "bucket",
          "required": true,
          "validate": {
            "type": "RegularExpression"
          }
        },
        {
          "name": "key",
          "required": true,
          "validate": {
            "type": "RegularExpression"
          }
        },
        {
          "name": "account",
          "required": true,
          "validate": {
            "type": "RegularExpression"
          }
        },
        {
          "name": "limit",
          "required": false,
          "defaultValue": 100,
          "validate": {
            "type": "Integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      ]
    }
  ],
  "meta": {
    "name": "nats",
