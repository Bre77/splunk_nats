            {
              "type": "text",
              "label": "Name",
              "validators": [
                {
                  "type": "regex",
                  "errorMsg": "Account Name must begin with a letter and consist exclusively of alphanumeric characters and underscores.",
                  "pattern": "^[a-zA-Z]\\w*$"
                },
                {
                  "type": "string",
                  "errorMsg": "Length of input name should be between 1 and 100",
                  "minLength": 1,
                  "maxLength": 100
                }
              ],
              "field": "name",
              "help": "A unique name for the account.",
              "required": true
            },
            {
              "type": "text",
              "label": "Servers",
              "field": "servers",
              "help": "Comma-separated list of NATS server URLs (e.g., nats://demo.nats.io:4222,tls://demo.nats.io:4443)",
              "required": true,
              "defaultValue": "nats://localhost:4222",
              "validators": [
                {
                  "type": "string",
                  "errorMsg": "Server URLs should be between 1 and 500 characters",
                  "minLength": 1,
                  "maxLength": 500
                }
              ]
            },
            {
              "type": "text",
              "label": "Username",
              "field": "username",
              "help": "Username for NATS authentication",
              "required": false,
              "validators": [
                {
                  "type": "string",
                  "errorMsg": "Username should be between 1 and 100 characters",
                  "minLength": 1,
                  "maxLength": 100
                }
              ]
            },
            {
              "type": "text",
              "label": "Password",
              "field": "password",
              "help": "Password for NATS authentication",
              "required": false,
              "encrypted": true,
              "validators": [
                {
                  "type": "string",
                  "errorMsg": "Password should be between 1 and 200 characters",
                  "minLength": 1,
                  "maxLength": 200
                }
              ]
            }
          ],
          "title": "Accounts"
        },
        {
          "type": "loggingTab"
        }
      ],
      "title": "Configuration",
      "description": "Set up your add-on"
